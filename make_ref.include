# Embed $(REF) text resources in a convenience library. The generated C source
# works with both ELF and Mach-O toolchains and is compiled by libtool normally.
#
# usage:
# REF = usage.txt
# include $(top_srcdir)/make_ref.include
# noinst_LTLIBRARIES [+]= $(LIB_REF)
# $PROGRAMNAME_LDADD += $(LIB_REF)

LIB_REF = lib_ref.la

lib_ref.c: $(REF) $(top_srcdir)/auxdir/embed_text.pl
	$(AM_V_GEN)$(PERL) $(top_srcdir)/auxdir/embed_text.pl $(addprefix $(srcdir)/,$(REF)) > $@.tmp && mv $@.tmp $@

# Keep generated resources out of source distributions and cscope input.
lib_ref_la_SOURCES =
nodist_lib_ref_la_SOURCES = lib_ref.c

CLEANFILES = lib_ref.c lib_ref.c.tmp
EXTRA_DIST = $(REF)
