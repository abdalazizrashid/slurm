<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.slurm.slurmd</string>
  <key>ProgramArguments</key>
  <array><string>@PREFIX@/sbin/slurmd</string><string>-D</string>
    <string>-f</string><string>@CONFIG_DIR@/slurm.conf</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>SLURM_CONF</key><string>@CONFIG_DIR@/slurm.conf</string></dict>
  <key>UserName</key><string>root</string>
  <key>WorkingDirectory</key><string>@STATE_DIR@</string>
  <key>StandardOutPath</key><string>@STATE_DIR@/log/slurmd-launchd.log</string>
  <key>StandardErrorPath</key><string>@STATE_DIR@/log/slurmd-launchd.log</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>60</integer>
  <key>AbandonProcessGroup</key><true/>
</dict>
</plist>
